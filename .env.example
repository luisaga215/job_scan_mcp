# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Optional custom base URL for OpenAI-compatible endpoints (vLLM, LM Studio, Groq)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API (OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Ollama Base URL (default is http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# System Defaults
# Model format: provider/model_name (e.g., openai/gpt-4o-mini, gemini/gemini-3.6-flash, deepseek/deepseek-chat, ollama/llama3)
DEFAULT_SCREENING_MODEL=openai/gpt-4o-mini
DEFAULT_EVALUATION_MODEL=openai/gpt-4o

# Custom storage directory (defaults to ~/.job_evaluator)
# DATA_DIR=C:/Users/username/.job_evaluator

# Logging Configuration
LOG_LEVEL=INFO
